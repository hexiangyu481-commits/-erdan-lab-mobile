{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "red-a8-mind",
  "main": "src/entry.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "RED_STATE"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://hexiangyu481-commits.github.io"
  }
}
