{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "red-r-assets",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://hexiangyu481-commits.github.io"
  }
}
